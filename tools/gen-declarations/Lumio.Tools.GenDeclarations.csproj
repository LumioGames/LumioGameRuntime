    <AssemblyName>Lumio.Tools.GenDeclarations</AssemblyName>
    <RootNamespace>Lumio.Tools.GenDeclarations</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;fixtures/**</DefaultItemExcludes>
    <NoWarn>$(NoWarn);CA1847;CA2249;CA1861;CA1822</NoWarn>
  </PropertyGroup>
  <ItemGroup>
