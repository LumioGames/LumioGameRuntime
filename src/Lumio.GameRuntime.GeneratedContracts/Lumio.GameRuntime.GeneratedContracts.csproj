<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RuntimeProductionProject>true</RuntimeProductionProject>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <AssemblyName>Lumio.GameRuntime.GeneratedContracts</AssemblyName>
    <RootNamespace>Lumio.GameRuntime.GeneratedContracts</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- CS8669:架构源发射的 `// <auto-generated />` 文件带可空注解却不发 `#nullable` 指令。
         编译器对 auto-generated 文件停用项目级可空上下文,注解因此失效并告警;本仓
         TreatWarningsAsErrors 把它升为错误(上游自己的 csproj 未开该开关,故上游不可见)。
         生成物不得手改,本项目又只含生成源,故在此项目范围内抑制。
         代价:这些 generated DTO 的引用类型对消费方是 nullable-oblivious。
         上游改为发射 `#nullable enable` 后必须删掉本行。 -->
    <NoWarn>$(NoWarn);CS8669</NoWarn>
  </PropertyGroup>

  <!-- Architecture-generated sources are copied by eng/generate-contracts.*. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <!-- ContractRuntime currently uses SHA256.HashData, which is net5+ only. -->
    <Compile Remove="Generated/Artifacts/contract-runtime-csharp/**/*.cs" />
  </ItemGroup>
</Project>
