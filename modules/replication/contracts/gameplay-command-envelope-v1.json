{
  "contractId": "lumio.gameplay-envelope.v1",
  "version": 1,
  "purpose": "RM-00011 ECS C-1 runtime envelope. WorldManager owns gameplay messages; transport only carries UTF-8 JSON frames and never defines a second wire model.",
  "decisionRecord": "ADR-049; Runtime C-1 message ownership is the single source for this contract.",
  "transport": {
    "kind": "websocket",
    "encoding": "utf8-json-text-frame",
    "direction": "client-to-server and server-to-client",
    "maxFrameBytes": 65536
  },
  "roles": [
    "client",
    "server"
  ],
  "mappings": {
    "chat.input": {
      "kind": "command",
      "direction": "c2s",
      "payload": "LumioBinV1 utf8-string",
      "maxUtf8Bytes": 512,
      "authority": "sender"
    },
    "field.write": {
      "kind": "command",
      "direction": "c2s",
      "payload": "LumioBinV1 entity/component/field/value",
      "authority": "owner"
    },
    "server.rpc": {
      "kind": "command",
      "direction": "c2s",
      "payload": "LumioBinV1 component/method/argument-array",
      "authority": "sender"
    }
  },
  "messages": {
    "Welcome": {
      "dir": "s2c",
      "required": {
        "messageType": "const:Welcome",
        "instanceId": "u64",
        "selfNetEntityId": "lowercase-128-bit-hex",
        "connectionGeneration": "u64"
      }
    },
    "WorldChange": {
      "dir": "s2c",
      "required": {
        "messageType": "const:WorldChange",
        "tick": "u64",
        "creates": "array:CreateRecord",
        "fields": "array:FieldChange",
        "destroys": "array:NetEntityId",
        "rpcs": "array:ClientRpcRecord"
      }
    },
    "InputCommand": {
      "dir": "c2s",
      "required": {
        "messageType": "const:InputCommand",
        "commands": "array:CommandBlock"
      }
    },
    "ConnectionSuperseded": {
      "dir": "s2c",
      "required": {
        "messageType": "const:ConnectionSuperseded",
        "reasonCode": "const:connection_superseded",
        "netEntityId": "lowercase-128-bit-hex",
        "newConnectionGeneration": "u64"
      }
    },
    "Error": {
      "dir": "s2c",
      "required": {
        "messageType": "const:Error",
        "code": "enum:errorCodes",
        "detail": "string"
      }
    }
  },
  "sharedTypes": {
    "CommandBlock": {
      "required": {
        "mappingId": "registered-command-mapping",
        "payload": "lowercase-hex",
        "payloadSha256": "lowercase-sha256-hex"
      }
    },
    "CreateRecord": {
      "required": {
        "entityType": "string",
        "netEntityId": "lowercase-128-bit-hex",
        "fields": "array:FieldValue"
      }
    },
    "FieldValue": {
      "required": {
        "componentId": "string",
        "fieldId": "string",
        "value": "string"
      }
    },
    "FieldChange": {
      "required": {
        "netEntityId": "lowercase-128-bit-hex",
        "componentId": "string",
        "fieldId": "string",
        "value": "string",
        "reason": "enum:sync|correction"
      }
    },
    "ClientRpcRecord": {
      "required": {
        "target": "lowercase-128-bit-hex",
        "componentId": "string",
        "method": "string",
        "args": "array:lowercase-hex",
        "messageId": "u64",
        "roomSequence": "u64",
        "sender": "lowercase-128-bit-hex",
        "appliedTick": "u64",
        "scope": "enum:room|aoi|owner|claim"
      }
    }
  },
  "boundedInput": {
    "policy": "reject",
    "rules": {
      "maxCommandsPerEnvelope": 16,
      "maxRpcArguments": 64,
      "chatTextMaxUtf8Bytes": 512,
      "ingressQueuePerConnection": 64
    }
  },
  "errorCodes": [
    "bad_envelope",
    "unsupported_contract",
    "unknown_command_type",
    "bad_payload_hash",
    "undecodable_payload",
    "block_order_violation",
    "state_block_kind_mismatch",
    "chat_text_too_long",
    "chat_rate_exceeded",
    "queue_full",
    "session_closed",
    "runtime_failure"
  ],
  "encoding": {
    "profile": "LumioBinV1",
    "integers": "little-endian u32/u64",
    "strings": "u32 byte-length prefix plus UTF-8 bytes",
    "digest": "sha256 of decoded payload, lowercase hex",
    "json": "unknown fields are rejected and all required fields are present"
  },
  "rules": [
    {
      "id": "welcome-before-world-change",
      "statement": "A client rejects WorldChange until at least one Welcome establishes the world instance.",
      "onViolation": "bad_envelope"
    },
    {
      "id": "known-message-type",
      "statement": "Only the five Runtime C-1 message types are accepted.",
      "onViolation": "bad_envelope"
    },
    {
      "id": "command-count",
      "statement": "InputCommand contains zero through sixteen command blocks.",
      "onViolation": "bad_envelope"
    },
    {
      "id": "payload-digest-recompute",
      "statement": "Each command payload digest is recomputed before dispatch.",
      "onViolation": "bad_payload_hash"
    },
    {
      "id": "lowercase-hex",
      "statement": "Wire hex values are lowercase and contain an even number of characters.",
      "onViolation": "bad_envelope"
    }
  ],
  "downstreamConsumption": {
    "runtime": [
      "WorldManager",
      "WorldMessage",
      "WireCodec"
    ],
    "replication": [
      "EntityBindingQuery",
      "ChatTypedMapping"
    ],
    "transport": [
      "host adapter"
    ]
  }
}
