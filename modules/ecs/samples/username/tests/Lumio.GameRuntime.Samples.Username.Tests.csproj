<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RuntimeTestProject>true</RuntimeTestProject>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <NoWarn>$(NoWarn);CS0436;CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lumio.GameRuntime.Samples.Username.Server.csproj">
      <Aliases>UsernameServer</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\Lumio.GameRuntime.Samples.Username.Client.csproj">
      <Aliases>UsernameClient</Aliases>
    </ProjectReference>
    <ProjectReference Include="../../../src/Lumio.GameRuntime.Ecs/Lumio.GameRuntime.Ecs.csproj" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="coverlet.MTP" />
  </ItemGroup>
</Project>
