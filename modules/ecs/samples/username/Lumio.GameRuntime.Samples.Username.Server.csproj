<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RuntimeProductionProject>true</RuntimeProductionProject>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <AssemblyName>Lumio.GameRuntime.Samples.Username.Server</AssemblyName>
    <RootNamespace>Lumio.GameRuntime.Samples.Username</RootNamespace>
    <LumioEcsGenerate>true</LumioEcsGenerate>
    <LumioEcsSide>server</LumioEcsSide>
    <DefineConstants>$(DefineConstants);LUMIO_SERVER</DefineConstants>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/*.Client.cs;generated/client/**;tests/**</DefaultItemExcludes>
    <NoWarn>$(NoWarn);CA1051;CA1711;CA1707;CA1034;CA1822</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Lumio.GameRuntime.Ecs/Lumio.GameRuntime.Ecs.csproj" />
    <Compile Include="../../../../src/Lumio.GameRuntime.GeneratedContracts/Generated/Compatibility/IsExternalInit.cs" Link="Compatibility/IsExternalInit.cs" />
  </ItemGroup>
</Project>
